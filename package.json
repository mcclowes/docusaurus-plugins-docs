    "docusaurus-plugin-cookie-consent": "^4.5.0",
    "docusaurus-plugin-glossary": "^3.2.0",
    "docusaurus-plugin-new-post-toast": "file:./vendor/docusaurus-plugin-new-post-toast-0.2.0.tgz",
